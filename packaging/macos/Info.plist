<?xml version="1.0" encoding="UTF-8"?>
<!-- Bundle description of losslessaudiocut.app. packaging/macos/dmg.sh
     replaces @VERSION@ (the full version, e.g. 1.2.0 or
     0.1.0-dev.20261104.b46df06) and @SHORT_VERSION@ (only X.Y.Z, the form
     macOS expects in CFBundleShortVersionString and CFBundleVersion). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>losslessaudiocut</string>
    <!-- Documents the app opens: macOS offers it under "Open With" (and in
         the Dock) for these types, but never makes it the default handler
         (LSHandlerRank Alternate). The list must equal the types of
         lac_app::file_types that are associated by extension;
         crates/lac-app/tests/packaging.rs checks it. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Audio recording</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.mp3</string>
                <string>public.mpeg-4-audio</string>
                <string>public.ac3-audio</string>
                <string>public.aac-audio</string>
                <string>org.xiph.ogg-audio</string>
                <string>org.xiph.opus</string>
                <string>org.xiph.speex</string>
                <string>org.xiph.flac</string>
                <string>com.microsoft.waveform-audio</string>
                <string>public.aiff-audio</string>
                <string>org.matroska.mka</string>
            </array>
        </dict>
    </array>
    <!-- Types macOS itself may not define (public.mp3 and the MPEG-4
         audio, AC-3, WAV and AIFF types it does). An imported declaration only applies where no
         other app or the system declares the type. -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.xiph.ogg-audio</string>
            <key>UTTypeDescription</key>
            <string>Ogg Vorbis audio</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.audio</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ogg</string>
                    <string>oga</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>audio/ogg</string>
                    <string>audio/x-vorbis+ogg</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.xiph.opus</string>
            <key>UTTypeDescription</key>
            <string>Opus audio</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.audio</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>opus</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>audio/x-opus+ogg</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.xiph.speex</string>
            <key>UTTypeDescription</key>
            <string>Speex audio</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.audio</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>spx</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>audio/x-speex</string>
                    <string>audio/x-speex+ogg</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.xiph.flac</string>
            <key>UTTypeDescription</key>
            <string>FLAC audio</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.audio</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>flac</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>audio/flac</string>
                    <string>audio/x-flac</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.matroska.mka</string>
            <key>UTTypeDescription</key>
            <string>Matroska audio</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.audio</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mka</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>audio/x-matroska</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleExecutable</key>
    <string>losslessaudiocut</string>
    <key>CFBundleIconFile</key>
    <string>losslessaudiocut</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.gunterkoenigsmann.losslessaudiocut</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>losslessaudiocut</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@SHORT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@SHORT_VERSION@</string>
    <key>CFBundleGetInfoString</key>
    <string>losslessaudiocut @VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>GPL-3.0-or-later</string>
</dict>
</plist>
